# Environment Variables — Tienda Nube Integration

# App credentials (from Tienda Nube Partners panel)
TIENDANUBE_CLIENT_ID=""
TIENDANUBE_CLIENT_SECRET=""

# Store credentials (obtained via OAuth — see .agents/workflows/tiendanube-setup.md)
# user_id returned in the OAuth callback IS the Store ID
TIENDANUBE_STORE_ID=""
TIENDANUBE_ACCESS_TOKEN=""

# Public store URL (no trailing slash)
NEXT_PUBLIC_TIENDANUBE_STORE_URL="https://<storename>.mitiendanube.com"
